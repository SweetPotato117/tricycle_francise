{
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.9.0"
    }
  },
  "routes": [
    {
      "src": "/((?:admin|controllers|rider)/(?:[A-Za-z0-9_-]+/)*[A-Za-z0-9_-]+\\.php)",
      "dest": "/api/index.php"
    },
    {
      "src": "/",
      "dest": "/index.html"
    },
    {
      "src": "/(index\\.html|(?:assets|admin|rider)/[A-Za-z0-9_./-]+\\.(?:html|css|js|png|jpg|jpeg|svg|gif|webp|ico|woff2?|ttf))",
      "dest": "/$1"
    },
    {
      "src": "/.*",
      "status": 404
    }
  ]
}
